{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portstead",
  "version": "0.1.0",
  "identifier": "io.connmanager.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Portstead", "width": 1280, "height": 820, "minWidth": 850, "minHeight": 580 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": false }
}
